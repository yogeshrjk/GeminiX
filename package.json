{
  "name": "gemini-x",
  "displayName": "GeminiX",
  "description": "Explore and explain selected code with Gemini Live inside VS Code.",
  "version": "0.6.8",
  "icon": "media/gemini-x.png",
  "publisher": "YogeshRajak",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yogeshrjk/GeminiX"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "gemini",
    "live",
    "voice",
    "code explanation"
  ],
  "activationEvents": [
    "onView:liveline.chatView",
    "onCommand:liveline.configureApiKey",
    "onCommand:liveline.newChat",
    "onCommand:liveline.history",
    "onCommand:liveline.settings",
    "onCommand:liveline.refresh"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "media/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "check": "tsc --noEmit && eslint .",
    "package": "npm run check && npm test && npm run build && vsce package --out gemini-x-v0.6.8.vsix",
    "test": "node --import tsx --test tests/*.test.ts",
    "vscode:prepublish": "npm run build",
    "test:ui": "npm run build && node --test tests/webview.integration.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "liveline.configureApiKey",
        "title": "GeminiX: Configure Gemini API Key"
      },
      {
        "command": "liveline.newChat",
        "title": "GeminiX: New chat",
        "icon": "media/icons/new-chat.svg"
      },
      {
        "command": "liveline.history",
        "title": "GeminiX: Chat history",
        "icon": "media/icons/history.svg"
      },
      {
        "command": "liveline.settings",
        "title": "GeminiX: Settings",
        "icon": "media/icons/settings.svg"
      },
      {
        "command": "liveline.refresh",
        "title": "GeminiX: Refresh",
        "icon": "media/icons/refresh.svg"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liveline",
          "title": "GeminiX",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "liveline": [
        {
          "id": "liveline.chatView",
          "name": "",
          "icon": "media/icon.svg",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "liveline.refresh",
          "when": "view == liveline.chatView",
          "group": "navigation"
        },
        {
          "command": "liveline.newChat",
          "when": "view == liveline.chatView",
          "group": "navigation"
        },
        {
          "command": "liveline.history",
          "when": "view == liveline.chatView",
          "group": "navigation"
        },
        {
          "command": "liveline.settings",
          "when": "view == liveline.chatView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "GeminiX",
      "properties": {
        "liveline.voice": {
          "type": "string",
          "default": "Kore",
          "enum": [
            "Zephyr",
            "Puck",
            "Charon",
            "Kore",
            "Fenrir",
            "Leda",
            "Orus",
            "Aoede",
            "Callirrhoe",
            "Autonoe",
            "Enceladus",
            "Iapetus",
            "Umbriel",
            "Algieba",
            "Despina",
            "Erinome",
            "Algenib",
            "Rasalgethi",
            "Laomedeia",
            "Achernar",
            "Alnilam",
            "Schedar",
            "Gacrux",
            "Pulcherrima",
            "Achird",
            "Zubenelgenubi",
            "Vindemiatrix",
            "Sadachbia",
            "Sadaltager",
            "Sulafat"
          ],
          "description": "Gemini prebuilt voice used for Live API responses."
        },
        "liveline.preferredLanguage": {
          "type": "string",
          "default": "English",
          "enum": [
            "English",
            "Hindi",
            "Spanish",
            "French",
            "German",
            "Portuguese",
            "Japanese",
            "Korean",
            "Mandarin Chinese",
            "Arabic",
            "Russian",
            "Italian",
            "Bengali",
            "Marathi",
            "Tamil",
            "Telugu",
            "Turkish",
            "Indonesian"
          ],
          "description": "Language GeminiX asks Gemini to use for explanations."
        },
        "liveline.autoInterrupt": {
          "type": "boolean",
          "default": true,
          "description": "Allow speaking to interrupt Gemini's current response."
        },
        "liveline.behavior": {
          "type": "string",
          "default": "professional",
          "enum": [
            "professional",
            "friendly",
            "expert"
          ],
          "enumDescriptions": [
            "Clear, structured, and concise.",
            "Approachable and conversational.",
            "Deeply technical and precise."
          ],
          "description": "Explanation style used by Gemini."
        },
        "liveline.liveModel": {
          "type": "string",
          "default": "gemini-3.8-live",
          "enum": [
            "gemini-3.8-live",
            "gemini-3.1-flash-live-preview",
            "gemini-3.8-live-extended-thinking"
          ],
          "enumDescriptions": [
            "Gemini 3.8 Live (Default)",
            "Gemini 3.1 Flash Live",
            "Gemini 3.8 Live Extended Thinking (asynchronous reasoning and tools)"
          ],
          "description": "Live model used for bidirectional streaming voice conversations."
        },
        "liveline.thinkingLevel": {
          "type": "string",
          "default": "high",
          "enum": [
            "minimal",
            "low",
            "medium",
            "high"
          ],
          "enumDescriptions": [
            "Minimal thinking for lowest latency.",
            "Fast reasoning with concise thoughts.",
            "Balanced thinking depth and speed.",
            "Extended thinking for thorough, deep reasoning."
          ],
          "description": "Thinking level for Gemini Live extended thinking model."
        }
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "@types/vscode": "^1.96.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "playwright": "1.62.1",
    "shiki": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "ws": "^8.18.3"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "^1.2.9",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.7"
  }
}
